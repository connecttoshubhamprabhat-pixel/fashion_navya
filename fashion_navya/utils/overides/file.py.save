
import frappe
from frappe.core.doctype.file.file import File
from frappe.core.doctype.file.file import has_permission


class CustomFile(File):
	def is_downloadable(self):
		docname=self.attached_to_doctype
		user=frappe.session.user
		sudo_user=['pawasthy11@gmail.com','amita@navya.biz',"Administrator","printtech@navyacustom.com"]
		doc_record_user=['vivekd@navyacustom.com']
		if user in sudo_user:
			return has_permission(self, "read")
		else:
			return


@frappe.whitelist()
def check_file_type(doc,method):
	if doc.file_name:
		namesplit=doc.file_name.split(".")
		type_list=['psd','idraw']
		if namesplit[-1] in type_list:
			if doc._is_private==0:
				frappe.throw("Sorry ,The file should be uploade
