@frappe.whitelist()
def file_check_private(doc,method):
	if doc.file_name:
		namesplit=doc.file_name.split(".")
		type_list=['psd','idraw']
		if namesplit[-1] in type_list:
			if doc._is_private==0:
				frappe.throw("Sorry ,The file should be uploaded as private")


